{
  "name": "agentarium",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "engines": { "node": ">=22.18" },
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "verify:all": "node scripts/verify-all.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "assets:build": "pnpm --filter @agentarium/assets assets:build",
    "assets:check": "pnpm --filter @agentarium/assets assets:check",
    "agentarium": "node packages/cli/dist/bin.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
